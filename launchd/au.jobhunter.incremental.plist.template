<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>au.jobhunter.incremental</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PROJECT_ROOT__/scripts/run-jobhunter.sh</string>
    <string>--incremental</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_ROOT__</string>
  <key>StartInterval</key>
  <integer>10800</integer>
  <key>ThrottleInterval</key>
  <integer>900</integer>
  <key>StandardOutPath</key>
  <string>__PROJECT_ROOT__/output/launchd/incremental.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_ROOT__/output/launchd/incremental.stderr.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
